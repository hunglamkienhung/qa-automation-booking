{
  "name": "booking-qa",
  "version": "1.0.0",
  "description": "Hotel-booking domain: a self-written mini-stay service (search, hold, booking lifecycle and cancellation over one SQLite store) plus Frankfurter's live public FX API; BE over the store's DB and REST, FE over the app pages.",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "selftest": "node --test \"be/**/*.test.js\"",
    "be": "cucumber-js --tags @be",
    "be:db": "cucumber-js --tags \"@be and @db\"",
    "be:api": "cucumber-js --tags \"@be and @api\"",
    "fe": "cucumber-js --tags @fe",
    "fe:specs": "playwright test",
    "bdd": "cucumber-js",
    "report": "qa-report",
    "verify": "qa-verify",
    "bugflow": "qa-bugflow",
    "clean": "node -e \"for (const d of ['reports','queue','state','test-results']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@portfolio/core": "file:../core/node"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@playwright/test": "^1.49.0"
  }
}
